# 실제 값은 .env에만 넣고, .env는 커밋하지 않는다. 키는 팀 DM으로만 공유.
SPRING_PROFILES_ACTIVE=local
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AI
LLM_API_KEY=
# 비우면 gpt-5-mini
LLM_MODEL=

# 카카오 로그인. 클라이언트 시크릿은 콘솔에서 켜져 있을 때만
KAKAO_REST_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:5173/oauth/kakao
# 카카오 없이 공용 테스트 계정으로 로그인 (POST /api/v1/auth/demo). 대회가 끝나면 false
DEMO_LOGIN_ENABLED=true

# 운영(prod)만 넣는다. 로컬은 개발용 JWT 키와 H2 메모리 DB를 쓴다
# JWT 키 만들기: openssl rand -base64 48
JWT_SECRET_KEY=
DB_NAME=dojang
DB_USERNAME=dojang
DB_PASSWORD=
DB_ROOT_PASSWORD=
DOMAIN=
